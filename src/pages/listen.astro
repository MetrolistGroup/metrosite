---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, defaultLocale } from '../i18n';

const code = Astro.url.searchParams.get('code');
const locale = Astro.locals.locale ?? defaultLocale;
const _t = (key: string) => t(locale, key);
---

<BaseLayout title={_t('listen.title')} description={_t('listen.subtitle')}>

  <div class="listen-page">
    <div class="container listen-page__inner">

      <!-- Back link -->
      <a href="/" class="listen-page__back">
        <span class="icon" aria-hidden="true">arrow_back</span>
        {_t('listen.back')}
      </a>

      <!-- Header -->
      <header class="listen-page__header">
        <p class="listen-page__kicker">{_t('listen.kicker')}</p>
        <h1 class="listen-page__title">{_t('listen.title')}</h1>
        <p class="listen-page__sub">{_t('listen.subtitle')}</p>
      </header>

      <!-- Room code block -->
      {
        code ? (
          <div class="listen-page__code-block" id="code-block">
            <span class="listen-page__code-label">{_t('listen.code.label')}</span>
            <code class="listen-page__code-value" id="room-code">{code}</code>
            <button type="button" class="listen-page__copy-btn" id="copy-btn">
              <span class="icon" aria-hidden="true">content_copy</span>
              <span id="copy-label" data-copied={_t('listen.code.copied')}>{_t('listen.code.copy')}</span>
            </button>
          </div>
        ) : (
          <div class="listen-page__code-empty">
            <span class="icon" aria-hidden="true">link_off</span>
            <p>{_t('listen.code.empty')}</p>
          </div>
        )
      }

      <!-- Two cards -->
      <div class="listen-page__cards">
        <article class="listen-page__card">
          <div class="listen-page__card-icon-wrap listen-page__card-icon-wrap--primary">
            <span class="icon" aria-hidden="true">music_note</span>
          </div>
          <h2 class="listen-page__card-title">{_t('listen.card.open.title')}</h2>
          <p class="listen-page__card-body">{_t('listen.card.open.body')}</p>
          <ol class="listen-page__steps">
            <li set:html={_t('listen.card.open.step1')} />
            <li set:html={_t('listen.card.open.step2')} />
            <li set:html={_t('listen.card.open.step3')} />
          </ol>
          {
            code && (
              <a href={`/listen?code=${encodeURIComponent(code)}`} class="btn btn-filled btn-lg listen-page__cta">
                <span class="icon" aria-hidden="true">open_in_new</span>
                {_t('listen.card.open.cta')}
              </a>
            )
          }
        </article>

        <article class="listen-page__card">
          <div class="listen-page__card-icon-wrap listen-page__card-icon-wrap--primary">
            <span class="icon" aria-hidden="true">download</span>
          </div>
          <h2 class="listen-page__card-title">{_t('listen.card.download.title')}</h2>
          <p class="listen-page__card-body">{_t('listen.card.download.body')}</p>
          <a href="https://github.com/MetrolistGroup/Metrolist/releases" class="btn btn-filled btn-lg" target="_blank" rel="noopener noreferrer">
            <span class="icon" aria-hidden="true">download</span>
            {_t('listen.card.download.cta')}
          </a>
        </article>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  function setupCopyButton() {
    const copyBtn = document.getElementById('copy-btn');
    const codeEl = document.getElementById('room-code');
    const copyLabel = document.getElementById('copy-label');

    if (!copyBtn || !codeEl || !copyLabel) return;

    copyBtn.addEventListener('click', async () => {
      const text = codeEl.textContent || '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Fallback for older browsers / insecure contexts
        const input = document.createElement('input');
        input.value = text;
        input.style.position = 'fixed';
        input.style.opacity = '0';
        input.style.pointerEvents = 'none';
        document.body.appendChild(input);
        input.select();
        input.setSelectionRange(0, text.length);
        try {
          document.execCommand('copy');
        } catch { /* clipboard unavailable */ }
        document.body.removeChild(input);
      } finally {
        const originalText = copyLabel.textContent;
        copyLabel.textContent = copyLabel.dataset.copied || 'Copied';
        setTimeout(() => {
          copyLabel.textContent = originalText;
        }, 2000);
      }
    });
  }

  document.addEventListener('astro:page-load', setupCopyButton);
</script>

<style is:global>
  .listen-page {
    padding: 48px 0 80px;
  }

  .listen-page__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .listen-page__back {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--unit) * 2);
    margin-bottom: calc(var(--unit) * 8);
    padding: 8px 14px;
    border-radius: var(--radius-s);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--md-sys-color-primary);
    text-decoration: none;
    transition: background 150ms cubic-bezier(0.2, 0, 0, 1);
  }

  .listen-page__back:hover {
    background: color-mix(in srgb, var(--md-sys-color-primary) 14%, transparent);
  }

  .listen-page__kicker {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--md-sys-color-primary);
    margin-bottom: 8px;
  }

  .listen-page__title {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--md-sys-color-on-background);
    margin-bottom: calc(var(--unit) * 4);
  }

  .listen-page__sub {
    font-size: 1.0625rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.6;
    max-width: 48ch;
    margin-bottom: calc(var(--unit) * 8);
  }

  .listen-page__code-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--unit) * 4);
    background: var(--md-sys-color-surface-container-high);
    border-radius: var(--radius-m);
    padding: 32px 24px;
    margin-bottom: calc(var(--unit) * 7);
  }

  .listen-page__code-label {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--md-sys-color-on-surface-variant);
  }

  .listen-page__code-value {
    font-family: 'JetBrains Mono Variable', 'Google Sans Flex', 'Roboto', monospace;
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: var(--md-sys-color-on-surface);
    text-align: center;
    user-select: all;
  }

  .listen-page__copy-btn {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--unit) * 2);
    padding: 10px 24px;
    border: none;
    border-radius: var(--radius-s);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    font-family: 'Google Sans Flex', 'Roboto', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 150ms cubic-bezier(0.2, 0, 0, 1);
  }

  .listen-page__copy-btn:hover {
    background: var(--md-sys-color-surface-container-highest);
  }

  .listen-page__code-empty {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    margin-bottom: calc(var(--unit) * 7);
    border-radius: var(--radius-m);
    background: var(--md-sys-color-surface-variant);
    color: var(--md-sys-color-on-surface-variant);
  }

  .listen-page__code-empty .icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .listen-page__code-empty p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .listen-page__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: calc(var(--unit) * 4);
    margin-bottom: calc(var(--unit) * 7);
  }

  @media (min-width: 640px) {
    .listen-page__cards {
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
  }

  .listen-page__card {
    border-radius: var(--radius-m);
    padding: 28px 24px;
    background: var(--md-sys-color-surface-container);
    display: flex;
    flex-direction: column;
  }

  .listen-page__card-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .listen-page__card-icon-wrap .icon {
    font-size: 1.5rem;
  }

  .listen-page__card-icon-wrap--primary {
    background: color-mix(in srgb, var(--md-sys-color-primary) 20%, transparent);
    color: var(--md-sys-color-primary);
  }

  .listen-page__card-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 10px;
  }

  .listen-page__card-body {
    font-size: 0.9375rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.65;
    margin-bottom: calc(var(--unit) * 4);
  }

  .listen-page__steps {
    margin: 0 0 auto 1.2em;
    padding: 0;
    font-size: 0.875rem;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.75;
  }

  .listen-page__steps li {
    margin-bottom: 6px;
  }

  .listen-page__cta {
    margin-top: 16px;
    align-self: start;
  }

  /* Icon utility — scoped to listen page */
  .listen-page .icon {
    font-family: 'Material Symbols Rounded';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    font-feature-settings: 'liga';
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    user-select: none;
  }

  /* Button base styles — scoped to listen page */
  .listen-page .btn {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--unit) * 2);
    padding: 10px 24px;
    border: none;
    border-radius: var(--radius-s);
    font-family: 'Google Sans Flex', 'Roboto', sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background 150ms cubic-bezier(0.2, 0, 0, 1), box-shadow 150ms cubic-bezier(0.2, 0, 0, 1);
    line-height: 1;
  }

  .listen-page .btn-lg {
    padding: 14px 32px;
    font-size: 1rem;
  }

  .listen-page .btn-tonal {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
  }

  .listen-page .btn-tonal:hover {
    background: var(--md-sys-color-surface-container-highest);
  }

  .listen-page .btn-filled {
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
  }

  .listen-page .btn-filled:hover {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
  }
</style>
